# Estos correos deben crearse fuera de la app, por ejemplo en Google Workspace,
# Zoho Mail u otro proveedor de email con dominio propio.
INSTITUTIONAL_EMAIL=reflab.institucional@gmail.com
SUPPORT_EMAIL=reflab.institucional@gmail.com

# Resend debe configurarse en Vercel o en el proveedor de despliegue.
# No hardcodear esta clave en el codigo.
RESEND_API_KEY=

# Mientras no haya dominio verificado en Resend, usar el remitente de prueba.
# Cuando el dominio reflab.app este verificado, se puede cambiar por institucional@reflab.app.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Proveedor de email. Usar "smtp" para Gmail/Google Workspace y "resend" para Resend.
EMAIL_PROVIDER=smtp

# SMTP para Gmail. SMTP_PASSWORD debe ser una clave de aplicacion de Google,
# no la contrasena normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=reflab.institucional@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=reflab.institucional@gmail.com

# URL publica de la app, usada en emails transaccionales.
APP_URL=https://reflab.app

# Recuperacion de emergencia, desactivada por defecto. El rol canonico vive en
# user_global_roles y se vincula al Clerk User ID, nunca al email.
REFLAB_SUPER_ADMIN_RECOVERY_ENABLED=false
REFLAB_SUPER_ADMIN_RECOVERY_EMAILS=

# Supabase. La publishable key puede exponerse al navegador; service_role nunca.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad temporal con proyectos que todavia usan la anon key anterior.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Guard obligatorio para pruebas de seguridad conectadas. Mantener false hasta
# disponer de un proyecto Development aislado y autorizar su referencia exacta.
APP_ENV=development
CLERK_ENV=development
SUPABASE_ENV=development
SUPABASE_PROJECT_REF=
ENABLE_DEVELOPMENT_IDENTITY_LINKER=false
DEVELOPMENT_IDENTITY_LINK_SECRET=
ALLOW_SECURITY_TESTS=false
EXPECTED_TEST_SUPABASE_PROJECT_REF=

# Guard independiente para reconstruir la baseline en Development. La URL de
# base contiene credenciales y debe existir solo en el entorno local seguro.
ALLOW_BASELINE_VALIDATION=false
EXPECTED_TEST_SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=

# Firebase Cloud Messaging para notificaciones push web.
# Las NEXT_PUBLIC_* se usan en el navegador. Las FIREBASE_* se usan en el servidor.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Secreto opcional para proteger /api/notifications/scheduled cuando lo llama Vercel Cron.
CRON_SECRET=

# Proveedor deportivo para Mis partidos. Mantener las credenciales siempre del lado servidor.
SPORTS_API_PROVIDER=api_football
SPORTS_API_BASE_URL=https://v3.football.api-sports.io
SPORTS_API_TOKEN=

# RefLab Coach. La clave se usa exclusivamente en el servidor.
OPENAI_API_KEY=
REFLAB_COACH_MODEL=gpt-4o-mini

# Limites seguros por usuario y por funcion de Coach.
COACH_RATE_LIMIT_MAX=20
COACH_RATE_LIMIT_WINDOW_SECONDS=600
COACH_MAX_BODY_BYTES=65536
